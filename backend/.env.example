DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
UPLOAD_DIR=./storage
MAX_UPLOAD_BYTES=524288000
PORT=4000

# Optional format validation for government/official IDs. Leave blank if formats vary by authority.
OFFICIAL_ID_REGEX=^[A-Z0-9-]{4,40}$
# URL of the separate Python face-verification service
FACE_SERVICE_URL=http://localhost:5001
